{
  "name": "wattlabel",
  "version": "0.1.0",
  "private": true,
  "description": "가전효율사전 — 한국에너지공단 에너지소비효율 등급 제품 정보 기반 정적 사이트",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "probe": "node --env-file-if-exists=.env scripts/probe.mjs",
    "fetch": "node --env-file-if-exists=.env scripts/fetch.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "build": "node --env-file-if-exists=.env scripts/build.mjs",
    "build:sample": "node scripts/make-fixtures.mjs && node scripts/build.mjs --fixtures",
    "check": "node --env-file-if-exists=.env scripts/check.mjs",
    "preview": "npx wrangler pages dev dist"
  }
}
